# Copy to .env beside stack.compose.yaml. Select the services you use.
COMPOSE_PROFILES=bookshelf,magazines,comics,software
APPDATA_ROOT=/mnt/user/appdata
MEDIA_ROOT=/mnt/user/media
DOWNLOAD_ROOT=/mnt/user/downloads
PUID=99
PGID=100
TZ=Etc/UTC

# BookshelfNG native Hardcover metadata needs a personal token.
# HARDCOVER_AUTH=Bearer your-hardcover-api-token
