#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

service_was_active=false

finish_backup() {
	local exit_code=$?
	trap - EXIT
	if [[ "$service_was_active" == true ]]; then
		ynh_systemctl --service="$app" --action="start" || exit_code=$?
	fi
	if [[ "$exit_code" == 0 ]]; then
		true
	else
		false && true
	fi
	ynh_exit_properly
}

# Keep the helper's exit handler in the chain so it still reports failures and
# runs YunoHost cleanup after the service has been restarted.
trap finish_backup EXIT

#=================================================
# STOP THE SERVICE FOR A CONSISTENT DATABASE BACKUP
#=================================================
if systemctl is-active --quiet "$app"; then
	service_was_active=true
	ynh_script_progression "Stopping SeerrNG for a consistent database backup..."
	ynh_systemctl --service="$app" --action="stop"
fi

#=================================================
# BACKUP PERSISTENT DATA
#=================================================
ynh_script_progression "Snapshotting SeerrNG data..."
mkdir -p "$YNH_APP_BACKUP_DIR/data"
rsync --archive --delete \
	--exclude="/cache/" \
	--exclude="/logs/" \
	"$data_dir/" "$YNH_APP_BACKUP_DIR/data/"

#=================================================
# BACKUP THE APP MAIN DIR
#=================================================
ynh_backup "$install_dir"

#=================================================
# BACKUP SYSTEM CONFIGURATION
#=================================================
ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_backup "/etc/systemd/system/$app.service"

#=================================================
# END OF SCRIPT
#=================================================
ynh_print_info "SeerrNG backup declaration completed"
